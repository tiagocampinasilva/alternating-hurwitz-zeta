                          "2"]], "-", "angle"}]}], ";", RowBox[{"den", "=", 
                          RowBox[{"1", "+", RowBox[{SqrtBox["2"], " ", "r"}], 
                          "+", SuperscriptBox["r", "2"]}]}], ";", RowBox[
                          {"f1", "=", FractionBox[RowBox[{"1", "-", RowBox[
                          {"\[ImaginaryI]", " ", "x", " ", "ff"}]}], 
                          "\[Pi]"]}], ";", RowBox[{RowBox[{"der", "[", 
                          "expr_", "]"}], ":=", RowBox[{RowBox[{SubscriptBox[
                          "\[PartialD]", "x"], "expr"}], "+", RowBox[{"f1", 
                          " ", RowBox[{SubscriptBox["\[PartialD]", "ff"], 
                          "expr"}]}]}]}], ";", RowBox[{"f2", "=", RowBox[
                          {"der", "[", "f1", "]"}]}], ";", RowBox[{"f3", "=", 
                          RowBox[{"der", "[", "f2", "]"}]}], ";", RowBox[
                          {"jone", "=", RowBox[{RowBox[{FractionBox["1", 
                          "2"], " ", RowBox[{"(", RowBox[{"-", 
                          "\[ImaginaryI]"}], ")"}], " ", "f1"}], "-", 
