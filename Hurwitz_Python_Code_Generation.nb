                          "]"}]}], ")"}]}], "-", FractionBox["1", RowBox[
                          {"1", "+", RowBox[{"Exp", "[", RowBox[{"-", "b"}], 
                          "]"}]}]]}], ",", RowBox[{FractionBox[RowBox[{"w", 
                          "-", "v"}], RowBox[{"1", "-", "a"}]], "-", "w", 
