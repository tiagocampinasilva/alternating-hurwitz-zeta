                          FractionBox[RowBox[{RowBox[{"a", " ", "w"}], "-", 
                          "v"}], RowBox[{"1", "-", "a"}]]}], ";", RowBox[
                          {"t", "=", RowBox[{FractionBox["\[Pi]", 
                          SuperscriptBox["h", "2"]], "+", FractionBox["x", 
                          "h"]}]}], ";", RowBox[{"theta", "=", RowBox[
                          {"ArcTan", "[", RowBox[{"y", " ", SuperscriptBox[
                          "h", "2"]}], "]"}]}], ";", RowBox[{"dh", "=", 
                          RowBox[{RowBox[{"2", " ", "\[Pi]", " ", "y"}], "-", 
                          RowBox[{"2", " ", "t", " ", "theta"}], "+", RowBox[
                          {"\[ImaginaryI]", " ", "theta"}]}]}], ";", RowBox[
                          {"pp", "=", RowBox[{SuperscriptBox[RowBox[{"(", 
                          RowBox[{"1", "+", RowBox[{"\[ImaginaryI]", " ", 
                          "y", " ", SuperscriptBox["h", "2"]}]}], ")"}], 
                          RowBox[{RowBox[{"-", FractionBox["1", "2"]}], "-", 
                          RowBox[{"\[ImaginaryI]", " ", "t"}]}]], "-", 
                          SuperscriptBox[RowBox[{"(", RowBox[{"1", "-", 
                          RowBox[{"\[ImaginaryI]", " ", "y", " ", 
                          SuperscriptBox["h", "2"]}]}], ")"}], RowBox[
                          {RowBox[{"-", FractionBox["1", "2"]}], "-", RowBox[
                          {"\[ImaginaryI]", " ", "t"}]}]]}]}], ";", RowBox[
                          {"psi", "=", RowBox[{RowBox[{"-", FractionBox[
                          RowBox[{"\[Pi]", " ", "z"}], "h"]}], "-", RowBox[
                          {RowBox[{"(", RowBox[{FractionBox["1", "2"], "+", 
                          RowBox[{"\[ImaginaryI]", " ", "t"}]}], ")"}], " ", 
                          RowBox[{"Log", "[", RowBox[{"1", "+", RowBox[
                          {"\[ImaginaryI]", " ", "h", " ", "z"}]}], 
                          "]"}]}]}]}], ";", RowBox[{"phi", "=", RowBox[
                          {RowBox[{"x", " ", "z"}], "-", RowBox[{FractionBox[
                          "1", "2"], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
                          SuperscriptBox["z", "2"]}]}]}], ";", RowBox[
                          {"linear", "=", RowBox[{RowBox[{FractionBox["1", 
                          "2"], " ", RowBox[{"(", RowBox[{"-", 
                          "\[ImaginaryI]"}], ")"}], " ", "z"}], "-", RowBox[
                          {FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
                          "x", " ", SuperscriptBox["z", "2"]}], "-", 
