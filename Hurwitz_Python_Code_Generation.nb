                          "f2"}], "2"], "-", FractionBox[RowBox[{"\[Pi]", 
                          " ", "f3"}], "3"]}]}], ";", RowBox[{"raw", "=", 
                          RowBox[{"{", RowBox[{RowBox[{RowBox[{FractionBox[
                          "1", "2"], " ", RowBox[{"(", RowBox[{"1", "+", 
