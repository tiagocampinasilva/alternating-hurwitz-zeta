           Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"wlResiduals", 
                    "=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {"a", ",", "w", ",", "v", ",", "b", ",", "h", ",", 
                          "x", ",", "y", ",", "z", ",", "r", ",", "ff", ",", 
                          "theta", ",", "k", ",", "dh", ",", "t", ",", "pp", 
                          ",", "psi", ",", "linear", ",", "phi", ",", 
                          "angle", ",", "delta", ",", "den", ",", "f1", ",", 
