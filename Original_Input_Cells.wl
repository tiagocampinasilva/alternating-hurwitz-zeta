HoldComplete[ClearAll[Znumeric, Fnum, Gnum, Rnumeric, scaledR, testRow]; Znumeric[(q_)?NumericQ, (x_)?NumericQ, wp_:40] := Module[{qq = N[q, wp], xx = N[x, wp], tt, ss}, tt = Pi*qq + xx*Sqrt[qq]; ss = 1/2 + I*tt; (qq^(I*tt)*(Zeta[ss, qq/2] - Zeta[ss, (qq + 1)/2]))/2^ss]; Fnum[(x_)?NumericQ, wp_:40] := Module[{xx = N[x, wp]}, N[(1/2)*(1 + I)*Exp[-((I*xx^2)/(2*Pi))]*Erfc[-((Exp[(1/4)*(-I)*Pi]*xx)/Sqrt[2*Pi])], wp]]; Gnum[(x_)?NumericQ, wp_:40] := Module[{xx = N[x, wp]}, N[1/2 + I/(6*Pi) - (xx^2*(1 - I*xx*Fnum[x, wp]))/(6*Pi^2), wp]]; Rnumeric[(q_)?NumericQ, (x_)?NumericQ, wp_:40] := Znumeric[q, x, wp] - Fnum[x, wp] - Gnum[x, wp]/Sqrt[N[q, wp]]; scaledR[(q_)?NumericQ, (x_)?NumericQ, wp_:40] := q*Abs[Rnumeric[q, x, wp]]; testRow[(q_)?NumericQ, (x_)?NumericQ, wp_:40] := Association["q" -> q, "x" -> x, "precision" -> wp, "qAbsR" -> scaledR[q, x, wp], "boundPassesNumerically" -> TrueQ[scaledR[q, x, wp] < 43/10]]; ]

HoldComplete[a = 9/8; kappa = 67/20; coeffs = {0, 0, 3/4, 7/6, 241/84, 22/21, 484/441}; gauss[(k_Integer)?EvenQ] := With[{m = k/2}, (67*(2*m)!)/(a^m*(80*(4^m*m!)))]; gauss[(k_Integer)?OddQ] := With[{m = (k - 1)/2}, (1/2)*a^(-m - 1)*m!]; jUpper = Sum[coeffs[[k + 1]]*((7*gauss[k])/4 + k!*kappa^(-k - 1)), {k, 2, 6}]; mainB = 5/12 + 5/240 + 22/(7*72000) + 1/100000; mainC = jUpper/2 + mainB; Association["J upper" -> jUpper, "B upper" -> mainB, "Combined upper" -> mainC, "Below 4.3" -> mainC < 43/10]]

HoldComplete[qs = {100, 100001/1000, 201/2, 101, 150, 400, 1600}; xs = Range[-1, 1, 1/20]; rows = Flatten[Table[{q, x, scaledR[q, x, 55]}, {q, qs}, {x, xs}], 1]; extrema = Table[First[MaximalBy[Select[rows, First[#1] == q & ], Last]], {q, qs}]; precisionCheck = Max[Table[Abs[scaledR[r[[1]], r[[2]], 75] - Last[r]], {r, extrema}]]; Association["Points" -> Length[rows], "All below 4.3" -> AllTrue[rows, Last[#1] < 43/10 & ], "Maximum" -> First[MaximalBy[rows, Last]], "Maximum precision drift" -> precisionCheck]]

HoldComplete[zAP[q_, x_] := Module[{t = Pi*q + x*Sqrt[q], s, f, p = 60}, s = 1/2 + I*t; f[(y_)?NumericQ] := If[y == 0, -((I*s)/(Pi*q)), ((1 + (I*y)/q)^(-s) - (1 - (I*y)/q)^(-s))/(2*Sinh[Pi*y])]; 1/(2*Sqrt[q]) + (1/Sqrt[q])*(I*NIntegrate[f[y], {y, 0, 1, Sqrt[q], 4*Sqrt[q], Infinity}, WorkingPrecision -> p, AccuracyGoal -> 35, PrecisionGoal -> 35, MaxRecursion -> 30])]; apCheck = Table[{x, N[Abs[zAP[100, x] - Znumeric[100, x, 70]], 8]}, {x, {-1, 0, 1}}]; apCheck]

HoldComplete[ListLinePlot[Table[Rest /@ Select[rows, First[#1] == q & ], {q, qs}], Frame -> True, FrameLabel -> {"x", "q |R_q(x)|"}, PlotLegends -> (ToString[#1, InputForm] & ) /@ qs, PlotStyle -> (Directive[Black, AbsoluteThickness[1], AbsoluteDashing[#1]] & ) /@ {{}, {2, 2}, {5, 2}, {8, 2}, {8, 2, 2, 2}, {4, 2, 1, 2}, {10, 3, 3, 3}}, BaseStyle -> {FontFamily -> "Georgia", FontColor -> Black}, Background -> White, ImageSize -> Large]]

HoldComplete[bUpper = 3/12 + 3/240 + 22/(7*120000) + 1/100000; cUpper = jUpper/2 + bUpper; certificate = {N[jUpper, 20], N[bUpper, 20], N[cUpper, 20], cUpper < 4117/1000, 4117/1000 - cUpper}; z = 461/100; dUpper = (21*z)/100 + ((2*22)*z^3)/((7*3)*10000); expUpper[z_] := Sum[z^k/k!, {k, 0, 6}] + z^7/(7!*(1 - z/8)); localChecks = {expUpper[1/2] < 5/3, expUpper[1] < 11/4, (5/3)*(11/4 - 1) < 3, Sum[z^k/k!, {k, 0, 16}] > 100, dUpper < 989/1000, 22/7 > Pi, Pi > 157/50}; s2lo = 140/99; s2hi = 99/70; r0 = 3/10; vHi = r0/(s2lo + r0); deltaLo = r0/s2hi - (vHi - vHi^3/3 + vHi^5/5); ex = 11/20; twoScaleChecks = {s2lo^2 < 2 < s2hi^2, 0 < vHi < 1, deltaLo > 0, (157*deltaLo)/(50*r0^2) > 9/8 + 5/22, (10*157*deltaLo)/(50*r0) - 1/s2lo > 67/20, Sum[ex^k/k!, {k, 0, 6}] + ex^7/(7!*(1 - ex/8)) < 7/4, (8*22)/(9*7) < (67/40)^2}; polyCheck = Expand[((22*u^3)/21 + u^2/2 + u/2)^2 + (11*u^4)/7 + (2*u^3)/3 + u^2/2 - Sum[coeffs[[k + 1]]*u^k, {k, 2, 6}]] === 0; Association["Local inequalities" -> localChecks, "Two-scale inequalities" -> twoScaleChecks, "Polynomial identity" -> polyCheck, "Exact-arithmetic result" -> certificate]]
