Notebook[{
Cell["Verification of the alternating Hurwitz zeta calculations", "Title",ExpressionUUID->"3df19f84-92b1-4f0e-a482-36a49fcf0d7f"],

Cell["\<\
Manuscript: Explicit Uniform Remainder Estimate for the Alternating Hurwitz \
Zeta Function in a Joint Large-Parameter Regime.\
\>", "Text",ExpressionUUID->"29ddb87c-24c1-4c8e-b2cb-92684d301280"],

Cell["\<\
Wolfram Mathematica kernel: 15.0.1 for Mac OS X ARM (64-bit) (July 2, 2026). \
