Cell[TextData[{"Subtract ", Cell[BoxData[StyleBox[FormBox[TagBox[
                RowBox[{"F", "+", RowBox[{"h", " ", "G"}]}], HoldForm], 
               TraditionalForm], FontSize -> 14]], "InlineFormula", 
            ExpressionUUID -> "40a8b546-ed20-4440-b519-1dd5d12ba8b7"], " from \
the exact decomposition. Apply the Taylor estimate to the principal \
contribution and the revised kernel bound to the residual contribution."}], 
         "Text", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "70b32a87-23db-438f-b11c-cc6ef6654177"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["R", "q"], 
