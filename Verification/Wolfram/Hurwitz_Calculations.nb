Notebook[{

Cell[CellGroupData[{
Cell["An Explicit Uniform Error Estimate for \
the Alternating Hurwitz Zeta Function in a Coupled Large-Parameter Transition \
Regime", "Title", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
      FontFamily -> "Georgia", FontSize -> 22, FontColor -> 
       RGBColor[0, 0, 0], ExpressionUUID -> 
       "7942ae17-750d-4057-a972-ed45eca86c52"],

Cell["Tiago Manuel Serafim Campina da Silva", "Text", 
      CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
      FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
       RGBColor[0, 0, 0], ExpressionUUID -> 
       "98ad1e9f-8bb3-40a2-bac6-179a7b81ef23"],

Cell[CellGroupData[{

Cell["Abstract", "Section", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 16, FontWeight -> "Bold", FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "971685a5-b840-4a4b-995d-be2e6e58fd3c"],

Cell[TextData[{"We study a two-term approximation to the normalized \
alternating Hurwitz zeta function when ", Cell[BoxData[StyleBox[
              FormBox[TagBox[RowBox[{"t", "\[LongEqual]", RowBox[
                   {RowBox[{"\[Pi]", " ", "q"}], "+", RowBox[{"x", " ", 
                      SqrtBox["q"]}]}]}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "f2f2e9e2-5714-4884-bc13-58a861e6486c"], ", with real ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{"q", 
                  "\[GreaterEqual]", "100"}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "96728be2-b6bd-4740-9959-15233d01e21a"], " and ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{TemplateBox[{"x"}, 
                   "Abs"], "\[LessEqual]", "1"}], HoldForm], 
               TraditionalForm], FontSize -> 14]], "InlineFormula", 
            ExpressionUUID -> "a16c86aa-2e0c-4d92-b3d5-4e19c004696f"], ". An \
alternating Abel\[Dash]Plana decomposition isolates a principal integral and \
a residual kernel. After contour rotation, the principal integral yields a \
Fresnel term and a first correction of order ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[FractionBox["1", 
                 SqrtBox["q"]], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "bb61b963-32e4-467f-8265-a61d188486ef"], 
           ". The main uniform error estimate is ", 
           Cell[BoxData[StyleBox[FormBox[FractionBox["4.3", "q"], 
               TraditionalForm], FontSize -> 14]], "InlineFormula"], ". A \
grid of 287 points provides a numerical cross-check. We discuss the \
connection with Riemann\[Dash]Siegel integral formulas and specify the \
comparison needed to assess the scope of the result."}], "Text", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "bb1a04cc-b226-43b5-a6b8-695af3e7069e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 16, FontWeight -> "Bold", FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "72bcaa12-2893-428f-8f42-87e2d46e6d02"],

Cell[TextData[{"The scaling ", Cell[BoxData[StyleBox[FormBox[TagBox[
                RowBox[{"t", "\[LongEqual]", RowBox[{RowBox[{"\[Pi]", " ", 
                      "q"}], "+", RowBox[{"x", " ", SqrtBox["q"]}]}]}], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "2c771578-90b6-47d8-a156-be3fcd5fa705"], 
           " selects a window around ", Cell[BoxData[StyleBox[
              FormBox[TagBox[RowBox[{"t", "\[LongEqual]", RowBox[{"\[Pi]", 
                    " ", "q"}]}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "e87b0e3e-f4c6-4425-8d6a-b353e5f5fa8d"], " where the linear and \
quadratic terms of the scaled exponent both contribute. In Section 4 their \
limiting combination is ", Cell[BoxData[StyleBox[FormBox[TagBox[
                RowBox[{RowBox[{FractionBox["1", "2"], " ", RowBox[
                     {"(", RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", 
                    "\[Pi]", " ", SuperscriptBox["z", "2"]}], "+", 
                  RowBox[{"x", " ", "z"}]}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "f7f9c362-0f5d-42a4-b95a-dd5456d2d009"], ". This gives a Fresnel \
profile and explains why the approximation has a correction of order ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[FractionBox["1", 
                 SqrtBox["q"]], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "f8028c92-2181-43e9-b9f7-cee3c327e934"], "."}], "Text", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "e7e17690-daa5-441c-b5d1-8cdb52c84ade"],

Cell["Riemann\[Dash]Siegel \
integral representations for the Hurwitz and Lerch zeta functions were \
developed in [Balanzario2004, BalanzarioSanchez2012]. The alternating \
function lies in the Lerch family, so the resemblance of the Gaussian contour \
and integral representation calls for a direct comparison. Asymptotic \
expansions for Hurwitz\[Dash]Lerch and Hurwitz zeta [FerreiraLopez2004, \
FernandezFokas2018], uniform endpoint asymptotics [FernandezSpenceFokas2018], \
and expansions for the alternating Hurwitz zeta function and its derivatives \
[HuKim2024] provide further context. The specific calculation developed here \
is the explicit remainder estimate in the coupled window above, with the \
residual kernel and the contour remainder estimated separately.\n\nThe Lerch \
approximate functional equations are [GarunkstisLaurincikasSteuding2003] and \
[Miyagawa2017]. The relevant specialisation is \[Lambda] = 1/2. The \
comparison must account for truncation, residues and the error in the same \
coupled regime. [NavasPalencia2023] provides a computational comparison. \
[Nemes2017] provides broader context for explicit remainder bounds. \
Guthmann's extensions [GuthmannSquare1997, GuthmannCusp1997] provide context \
for the Riemann\[Dash]Siegel method.", "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "f26bbc8d-f23c-40db-9854-0bec816ecc03"],

Cell[TextData[{"Earlier drafts used bounds of ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[FractionBox["24.8`", "q"], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "800f3746-a623-476b-9870-92c11c6f0be8"], ", ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[FractionBox["11.3`", "q"], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "85b2b4d7-3a22-4d33-9be8-9342f59a0648"], ", and ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[FractionBox["4.3`", "q"], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "06f55c6b-907a-4c24-bc95-952edcaeb85e"], 
           ", the last of which is the main bound in this manuscript."}], 
         "Text", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "8f0f8181-573a-4cae-81a9-955123ea6279"],

Cell["To determine what \
follows from the published formulas, one must put them into the same \
normalization, match the principal and first correction terms, and compare \
the total remainder, including any finite sums or residues introduced by \
contour deformation. That comparison remains open. The manuscript therefore \
presents the constant as a proposed explicit estimate and leaves priority \
unsettled.", "Text", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "50130194-68e5-4715-b91f-2419b43805df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Statement and notation", "Section", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 16, FontWeight -> "Bold", 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "bc52e4f1-4a97-4cea-9f7b-488614b1043a"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {"q", "\[GreaterEqual]", "100"}], ",", RowBox[
                 {TemplateBox[{"x"}, "Abs"], "\[LessEqual]", "1"}], ",", 
                RowBox[{"h", "\[LongEqual]", FractionBox["1", SqrtBox[
                    "q"]]}], ",", RowBox[{"t", "\[LongEqual]", RowBox[
                   {RowBox[{"\[Pi]", " ", "q"}], "+", RowBox[{"x", " ", 
                      SqrtBox["q"]}]}]}], ",", RowBox[{"s", "\[LongEqual]", 
                  RowBox[{FractionBox["1", "2"], "+", RowBox[
                     {"\[ImaginaryI]", " ", "t"}]}]}]}], "}"}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "66dd6872-ce84-4eb0-9541-1b3386645a3a"],

Cell["Grouping the even and odd terms of the alternating series gives \
the Hurwitz zeta identity. The factor with exponent it normalises the \
oscillation.", "Text", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "b46ef434-d7e6-4227-9855-51c00e155b47"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["\[Zeta]", 
                 "\[ExponentialE]"], "(", RowBox[{"s", ",", "q"}], ")"}], 
              "\[LongEqual]", RowBox[{SuperscriptBox["2", RowBox[
                  {"-", "s"}]], " ", RowBox[{"(", RowBox[{RowBox[{"\[Zeta]", 
                      "(", RowBox[{"s", ",", FractionBox["q", "2"]}], ")"}], 
                    "-", RowBox[{"\[Zeta]", "(", RowBox[{"s", ",", 
                        FractionBox[RowBox[{"q", "+", "1"}], "2"]}], ")"}]}], 
                  ")"}]}]}], HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "9c1582d4-83d0-404e-9c74-beb545c87a5c"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["Z", "q"], 
                "(", "x", ")"}], "\[LongEqual]", RowBox[{SuperscriptBox["q", 
                 RowBox[{"\[ImaginaryI]", " ", "t"}]], " ", RowBox[
                 {SubscriptBox["\[Zeta]", "\[ExponentialE]"], "(", 
                  RowBox[{"s", ",", "q"}], ")"}]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "bb852811-24aa-4c91-8d1d-b0b742229ead"],

Cell[BoxData[FormBox[TagBox[RowBox[{TemplateBox[{RowBox[
                 {RowBox[{SubscriptBox["Z", "q"], "(", "x", ")"}], "-", 
                  RowBox[{"F", "(", "x", ")"}], "-", RowBox[{"h", " ", 
                    RowBox[{"G", "(", "x", ")"}]}]}]}, "Abs"], "<", 
              FractionBox["4.3", "q"]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "efcf48bd-ee0e-45b5-ae24-6f277cbd1307"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. The alternating Abel\[Dash]Plana decomposition", "Section", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 16, FontWeight -> "Bold", 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "1e2a6359-5f58-43e6-bac2-13fef77f451a"],

Cell["Apply the \
Gamma\[Dash]Laplace representation to finite alternating sums. Their \
geometric factors are uniformly bounded by 2 on the positive real axis, so \
dominated convergence gives the integral below.", "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "4a3cb428-ae63-4c73-88d8-c923212495b0"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["\[Zeta]", 
                 "\[ExponentialE]"], "(", RowBox[{"s", ",", "q"}], ")"}], 
              "\[LongEqual]", FractionBox[TemplateBox[{FractionBox[
                  RowBox[{SuperscriptBox["v", RowBox[{"s", "-", "1"}]], " ", 
                    RowBox[{"exp", "(", RowBox[{RowBox[{"-", "q"}], " ", 
                        "v"}], ")"}]}], RowBox[{"1", "+", RowBox[{"exp", "(", 
                      RowBox[{"-", "v"}], ")"}]}]], "v", "0", "\[Infinity]"}, 
                "InactiveIntegrate", DisplayFunction -> 
                 (RowBox[{SubsuperscriptBox[StyleBox["\[Integral]", 
                      "InactiveTraditional"], #3, #4], RowBox[{#1, RowBox[
                       {StyleBox["\[DifferentialD]", "InactiveTraditional"], 
                        #2}]}]}] & ), InterpretationFunction -> 
                 (RowBox[{RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
                    RowBox[{#1, ",", RowBox[{"{", RowBox[{#2, ",", #3, ",", 
                          #4}], "}"}]}], "]"}] & )], TemplateBox[{"s"}, 
                "Gamma"]]}], HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "1be676ec-cc5e-4fad-8ac5-8636f7cbb601"],

Cell[TextData[{"Insert the sine transform of the hyperbolic tangent \
as in manuscript Section 2. The estimate ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{TemplateBox[
                   {RowBox[{"sin", "(", RowBox[{"v", " ", "y"}], ")"}]}, 
                   "Abs"], "\[LessEqual]", RowBox[{"v", " ", "y"}]}], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "d1779a18-cad9-48e3-8b0e-b7e8f6c2e8cf"], " justifies \
interchanging the integrals. The two exponential terms in the sine then give \
the complex powers in Abel\[Dash]Plana."}], "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "c17836b6-e348-47ad-ba06-435bda3f16ca"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox["\[Zeta]", 
                 "\[ExponentialE]"], "(", RowBox[{"s", ",", "q"}], ")"}], 
              "\[LongEqual]", RowBox[{FractionBox[SuperscriptBox["q", 
                  RowBox[{"-", "s"}]], "2"], "+", RowBox[{"\[ImaginaryI]", 
                  " ", TemplateBox[{FractionBox[RowBox[{SuperscriptBox[
                        RowBox[{"(", RowBox[{"q", "+", RowBox[
                          {"\[ImaginaryI]", " ", "y"}]}], ")"}], RowBox[
                         {"-", "s"}]], "-", SuperscriptBox[RowBox[{"(", 
                          RowBox[{"q", "-", RowBox[{"\[ImaginaryI]", " ", 
                          "y"}]}], ")"}], RowBox[{"-", "s"}]]}], RowBox[
                      {"2", " ", RowBox[{"sinh", "(", RowBox[{"\[Pi]", " ", 
                          "y"}], ")"}]}]], "y", "0", "\[Infinity]"}, 
                   "InactiveIntegrate", DisplayFunction -> (RowBox[
                      {SubsuperscriptBox[StyleBox["\[Integral]", 
                         "InactiveTraditional"], #3, #4], RowBox[{#1, 
                         RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                   InterpretationFunction -> (RowBox[{RowBox[{"Inactive", 
                         "[", "Integrate", "]"}], "[", RowBox[{#1, ",", 
                         RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                          "}"}]}], "]"}] & )]}]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "21df8370-efea-4e00-8924-00d877acf7d1"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {RowBox[{"w", "(", "y", ")"}], "\[LongEqual]", RowBox[
                   {RowBox[{"exp", "(", RowBox[{RowBox[{"-", "\[Pi]"}], " ", 
                        "y"}], ")"}], " ", SuperscriptBox[RowBox[{"(", 
                       RowBox[{"1", "+", FractionBox[RowBox[{"\[ImaginaryI]", 
                          " ", "y"}], "q"]}], ")"}], RowBox[{"-", "s"}]]}]}], 
                ",", RowBox[{RowBox[{SubscriptBox["v", RowBox[{"-", "1"}]], 
                    "(", "y", ")"}], "\[LongEqual]", RowBox[
                   {RowBox[{"exp", "(", RowBox[{RowBox[{"-", "\[Pi]"}], " ", 
                        "y"}], ")"}], " ", SuperscriptBox[RowBox[{"(", 
                       RowBox[{"1", "-", FractionBox[RowBox[{"\[ImaginaryI]", 
                          " ", "y"}], "q"]}], ")"}], RowBox[{"-", 
                       "s"}]]}]}]}], "}"}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "785e3ad5-8fb4-4133-ba3d-2a2d02d41e55"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"K", "[", "y", "]"}], 
              "\[LongEqual]", FractionBox[RowBox[{RowBox[{RowBox[{"exp", "(", 
                     RowBox[{RowBox[{"-", "2"}], " ", "\[Pi]", " ", "y"}], 
                     ")"}], " ", RowBox[{"w", "(", "y", ")"}]}], "-", 
                 RowBox[{SubscriptBox["v", RowBox[{"-", "1"}]], "(", "y", 
                   ")"}]}], RowBox[{"1", "-", RowBox[{"exp", "(", 
                   RowBox[{RowBox[{"-", "2"}], " ", "\[Pi]", " ", "y"}], 
                   ")"}]}]]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "4eb6af02-ee68-402d-b6df-5635d43215ff"],

Cell["The fraction with \
numerator w minus v splits into w plus K. Multiplying by the normalising \
factor gives the exact decomposition.", "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "fe0bb93b-1bcd-43eb-ad09-c281614c1e68"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {RowBox[{"H", "(", RowBox[{"h", ",", "x"}], ")"}], 
                  "\[LongEqual]", RowBox[{"h", " ", TemplateBox[
                     {RowBox[{"w", "(", "y", ")"}], "y", "0", "\[Infinity]"}, 
                     "InactiveIntegrate", DisplayFunction -> (RowBox[
                        {SubsuperscriptBox[StyleBox["\[Integral]", 
                          "InactiveTraditional"], #3, #4], RowBox[{#1, 
                          RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                     InterpretationFunction -> (RowBox[{RowBox[{"Inactive", 
                          "[", "Integrate", "]"}], "[", RowBox[{#1, ",", 
                          RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                          "}"}]}], "]"}] & )]}]}], ",", RowBox[
                 {RowBox[{SubscriptBox["Z", "q"], "(", "x", ")"}], 
                  "\[LongEqual]", RowBox[{FractionBox["h", "2"], "+", 
                    RowBox[{"\[ImaginaryI]", " ", RowBox[{"H", "(", RowBox[
                         {"h", ",", "x"}], ")"}]}], "+", RowBox[
                     {"\[ImaginaryI]", " ", "h", " ", TemplateBox[
                       {RowBox[{"K", "[", "y", "]"}], "y", "0", 
                        "\[Infinity]"}, "InactiveIntegrate", 
                       DisplayFunction -> (RowBox[{SubsuperscriptBox[StyleBox[
                          "\[Integral]", "InactiveTraditional"], #3, #4], 
                          RowBox[{#1, RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                       InterpretationFunction -> (RowBox[{RowBox[{"Inactive", 
                          "[", "Integrate", "]"}], "[", RowBox[{#1, ",", 
                          RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                          "}"}]}], "]"}] & )]}]}]}]}], "}"}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "d15a8c00-5798-4264-a162-1c83bef870d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. The residual-kernel bound", "Section", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 16, FontWeight -> "Bold", 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "5299141e-4a26-471e-90d6-925fc665cac0"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[{"\[Theta]", 
                  "\[LongEqual]", RowBox[{SuperscriptBox["tan", RowBox[
                      {"-", "1"}]], "(", FractionBox["y", "q"], ")"}]}], ",", 
                RowBox[{RowBox[{"D", "[", "y", "]"}], "\[LongEqual]", 
                  RowBox[{RowBox[{"2", " ", "\[Pi]", " ", "y"}], "-", 
                    RowBox[{"2", " ", "t", " ", "\[Theta]"}], "+", 
                    RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]}]}], ",", 
                RowBox[{RowBox[{"K", "[", "y", "]"}], "\[LongEqual]", 
                  FractionBox[RowBox[{RowBox[{"w", "(", "y", ")"}], " ", 
                     RowBox[{"(", RowBox[{"1", "-", RowBox[{"exp", "(", 
                          RowBox[{"D", "[", "y", "]"}], ")"}]}], ")"}]}], 
                   RowBox[{RowBox[{"exp", "(", RowBox[{"2", " ", "\[Pi]", 
                         " ", "y"}], ")"}], "-", "1"}]]}]}], "}"}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "90b9a7e5-56ef-42b6-80a9-b4f320d87df5"],

Cell[TextData[{"For y up to log q, replace the argument y in each \
increasing term of the next bound by log q. The resulting terms decrease for \
", Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{"q", "\[GreaterEqual]", 
                  "100"}], HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "e357727c-39ea-4662-b272-33cfe3c6ec3a"], ", since the sign of \
the derivative of q raised to \[Minus]a times (log q) raised to k is the sign \
of ", Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{"k", "-", RowBox[
                   {"a", " ", RowBox[{"log", "(", "q", ")"}]}]}], HoldForm], 
               TraditionalForm], FontSize -> 14]], "InlineFormula", 
            ExpressionUUID -> "ac796198-055e-4b92-8fb3-b1b1cc6baa1c"], 
           ". Use the pairs (1/2, 1), (1, 1) and (2, 3)."}], "Text", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "0af852ff-0305-422c-9e0a-782271f99d8c"],

Cell[BoxData[FormBox[TagBox[RowBox[{TemplateBox[{RowBox[{"D", "[", 
                  "y", "]"}]}, "Abs"], "\[LessEqual]", RowBox[{FractionBox[
                 RowBox[{"2", " ", "y"}], SqrtBox["q"]], "+", FractionBox[
                 "y", "q"], "+", FractionBox[RowBox[{"2", " ", "\[Pi]", " ", 
                   SuperscriptBox["y", "3"]}], RowBox[{"3", " ", 
                   SuperscriptBox["q", "2"]}]]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "a3ce5daf-b7ed-4689-8121-08ac26d99726"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {TemplateBox[{RowBox[{"D", "[", "y", "]"}]}, "Abs"], "<", 
                  FractionBox["51902943991", "52500000000"], "<", FractionBox[
                   "989", "1000"]}], ",", RowBox[{TemplateBox[
                   {RowBox[{"w", "(", "y", ")"}]}, "Abs"], "\[LessEqual]", 
                  RowBox[{"exp", "(", FractionBox["y", SqrtBox["q"]], ")"}], 
                  "<", FractionBox["5", "3"]}]}], "}"}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "5b8d8f6c-de72-43c1-965d-7211af790adf"],

Cell[TextData[{"For ", Cell[BoxData[StyleBox[FormBox[TagBox[
                RowBox[{TemplateBox[{"D"}, "Abs"], "\[LessEqual]", "1"}], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "fd25e14b-aacf-40a7-afa1-d3e515196887"], ", factoring |D| out of \
the exponential series bounds its remaining sum by e \[Minus] 1. Together \
with ", Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{"\[ExponentialE]", "<", 
                  FractionBox["11", "4"]}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "97d7f06b-4280-4fd1-9fae-f0183a550097"], 
           ", this implies the factor 5 used in equation (18)."}], "Text", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "232dfbed-8a84-450f-835f-162a0211d14f"],

Cell[BoxData[FormBox[TagBox[RowBox[{TemplateBox[{RowBox[{"1", "-", 
                  RowBox[{"exp", "(", RowBox[{"D", "[", "y", "]"}], ")"}]}]}, 
               "Abs"], "\[LessEqual]", RowBox[{RowBox[{"(", RowBox[
                   {"\[ExponentialE]", "-", "1"}], ")"}], " ", TemplateBox[
                 {RowBox[{"D", "[", "y", "]"}]}, "Abs"]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
