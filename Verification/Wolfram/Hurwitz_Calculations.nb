              RowBox[{"5", " ", TemplateBox[{RowBox[{"D", "[", "y", "]"}]}, 
                 "Abs"]}]}], HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "eea43d02-a758-4fbb-b35d-f0395a5b1584"],

Cell["On the tail, use the \
original bound (19). On the short interval, extend the nonnegative moment \
integrands to infinity. Expanding the geometric series in the denominator \
gives these two moments.", "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "3c8184e5-6b6d-48c3-bdee-1d2ebbc5c1fa"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {TemplateBox[{FractionBox["y", RowBox[{RowBox[{"exp", "(", 
                         RowBox[{"2", " ", "\[Pi]", " ", "y"}], ")"}], "-", 
                       "1"}]], "y", "0", "\[Infinity]"}, "InactiveIntegrate", 
                   DisplayFunction -> (RowBox[{SubsuperscriptBox[StyleBox[
                         "\[Integral]", "InactiveTraditional"], #3, #4], 
                       RowBox[{#1, RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                   InterpretationFunction -> (RowBox[{RowBox[{"Inactive", 
                         "[", "Integrate", "]"}], "[", RowBox[{#1, ",", 
                         RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                          "}"}]}], "]"}] & )], "\[LongEqual]", FractionBox[
                   "1", "24"]}], ",", RowBox[{TemplateBox[{FractionBox[
                     SuperscriptBox["y", "3"], RowBox[{RowBox[{"exp", "(", 
                         RowBox[{"2", " ", "\[Pi]", " ", "y"}], ")"}], "-", 
                       "1"}]], "y", "0", "\[Infinity]"}, "InactiveIntegrate", 
                   DisplayFunction -> (RowBox[{SubsuperscriptBox[StyleBox[
                         "\[Integral]", "InactiveTraditional"], #3, #4], 
                       RowBox[{#1, RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                   InterpretationFunction -> (RowBox[{RowBox[{"Inactive", 
                         "[", "Integrate", "]"}], "[", RowBox[{#1, ",", 
                         RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                          "}"}]}], "]"}] & )], "\[LongEqual]", FractionBox[
                   "1", "240"]}]}], "}"}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "ce1a749d-8438-4040-b661-ae88468aa303"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SqrtBox["q"], " ", 
                TemplateBox[{TemplateBox[{RowBox[{"K", "[", "y", "]"}]}, 
                   "Abs"], "y", "0", "\[Infinity]"}, "InactiveIntegrate", 
                 DisplayFunction -> (RowBox[{SubsuperscriptBox[StyleBox[
                       "\[Integral]", "InactiveTraditional"], #3, #4], 
                     RowBox[{#1, RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                 InterpretationFunction -> (RowBox[{RowBox[{"Inactive", "[", 
                       "Integrate", "]"}], "[", RowBox[{#1, ",", RowBox[
                        {"{", RowBox[{#2, ",", #3, ",", #4}], "}"}]}], 
                     "]"}] & )]}], "\[LessEqual]", RowBox[{FractionBox["5", 
                 "12"], "+", FractionBox["5", RowBox[{"24", " ", SqrtBox[
                    "q"]}]], "+", FractionBox[RowBox[{"5", " ", "\[Pi]"}], 
                 RowBox[{"360", " ", SuperscriptBox["q", RowBox[{"3", "/", 
                      "2"}]]}]], "+", FractionBox[RowBox[{"3", " ", 
                   SuperscriptBox["q", RowBox[{FractionBox["1", "2"], "-", 
                      "\[Pi]"}]]}], "\[Pi]"]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "10872bf4-20bf-4ade-8323-649bf1daae5e"],

Cell[TextData[{"At ", Cell[BoxData[StyleBox[FormBox[TagBox[
                RowBox[{"q", "\[GreaterEqual]", "100"}], HoldForm], 
               TraditionalForm], FontSize -> 14]], "InlineFormula", 
            ExpressionUUID -> "a5ee2671-6338-4587-bc94-e9966fbc82a9"], " the \
tail is smaller than 10\:207b\:2075. The remaining terms are bounded with ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{"q", 
                  "\[GreaterEqual]", "100"}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "bf4967f9-f441-4ca3-9794-4b75f50f5dea"], " and \[Pi] < 22/7."}], 
         "Text", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "962a02f2-0fcd-4065-b726-c4e25c539e14"],

Cell[BoxData[FormBox[TagBox[RowBox[{SubscriptBox["B", "0"], 
              "\[LongEqual]", RowBox[{FractionBox["5", "12"], "+", 
                FractionBox["5", "240"], "+", FractionBox["22", 
                 RowBox[{"7", " ", "72000"}]], "+", FractionBox["1", 
                 "100000"]}], "\[LongEqual]", FractionBox["689147", 
               "1575000"]}], HoldForm], TraditionalForm]], "DisplayFormula", 
