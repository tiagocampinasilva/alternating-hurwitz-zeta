         ExpressionUUID -> "b47c76b8-f732-401f-9041-e2a184bc6b0a"],

Cell[BoxData[FormBox[TagBox[RowBox[{TemplateBox[{RowBox[
                 {RowBox[{"w", "(", "y", ")"}], " ", RowBox[{"(", RowBox[
                     {"1", "-", RowBox[{"exp", "(", RowBox[{"D", "[", "y", 
                          "]"}], ")"}]}], ")"}]}]}, "Abs"], "\[LessEqual]", 
              FractionBox[RowBox[{"35", " ", TemplateBox[{RowBox[{"D", "[", 
