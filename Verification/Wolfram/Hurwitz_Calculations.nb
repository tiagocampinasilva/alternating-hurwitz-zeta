Cell[TextData[{"Bound the Gaussian moments using ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{SqrtBox[FractionBox[
                    RowBox[{"8", " ", "\[Pi]"}], "9"]], "<", FractionBox[
                   "67", "40"]}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "df4ca0ea-a427-46f7-af24-abbda78e38f5"], " where needed. Summing \
the rational moment bounds and adding the residual contribution gives the \
following upper bound for the scaled error."}], "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "3a29405b-efd5-4404-835b-83c7e970f44a"],

