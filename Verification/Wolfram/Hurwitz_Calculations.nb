 Background->GrayLevel[
  1],ExpressionUUID->"b3261246-f4f8-4a28-8267-f5bebe043dee"],

Cell["\<\
With a fresh kernel, evaluate these Input cells in order. The returned values \
check the rational inequalities, the numerical grid, the precision stability \
of its maxima, and the Abel\[Dash]Plana comparison.\
\>", "Text",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->12,
 FontColor->GrayLevel[0],
 Background->GrayLevel[
  1],ExpressionUUID->"9140e8ca-63be-4cdf-91c1-da29b4894b89"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Znumeric", ",", "Fnum", ",", "Gnum", ",", "Rnumeric", ",", "scaledR", ",",
     "testRow"}], "]"}], ";", 
  RowBox[{
   RowBox[{"Znumeric", "[", 
    RowBox[{
     RowBox[{"q_", "?", "NumericQ"}], ",", 
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"wp_", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"qq", "=", 
        RowBox[{"N", "[", 
         RowBox[{"q", ",", "wp"}], "]"}]}], ",", 
       RowBox[{"xx", "=", 
        RowBox[{"N", "[", 
         RowBox[{"x", ",", "wp"}], "]"}]}], ",", "tt", ",", "ss"}], "}"}], ",", 
     RowBox[{
      RowBox[{"tt", "=", 
       RowBox[{
        RowBox[{"\[Pi]", " ", "qq"}], "+", 
        RowBox[{"xx", " ", 
         SqrtBox["qq"]}]}]}], ";", 
      RowBox[{"ss", "=", 
       RowBox[{
        FractionBox["1", "2"], "+", 
        RowBox[{"\[ImaginaryI]", " ", "tt"}]}]}], ";", 
      RowBox[{
       SuperscriptBox["qq", 
        RowBox[{"\[ImaginaryI]", " ", "tt"}]], " ", 
       SuperscriptBox["2", 
        RowBox[{"-", "ss"}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Zeta", "[", 
          RowBox[{"ss", ",", 
           FractionBox["qq", "2"]}], "]"}], "-", 
         RowBox[{"Zeta", "[", 
          RowBox[{"ss", ",", 
           FractionBox[
            RowBox[{"qq", "+", "1"}], "2"]}], "]"}]}], ")"}]}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Fnum", "[", 
    RowBox[{
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"wp_", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xx", "=", 
       RowBox[{"N", "[", 
        RowBox[{"x", ",", "wp"}], "]"}]}], "}"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[ImaginaryI]", " ", 
            SuperscriptBox["xx", "2"]}], 
           RowBox[{"2", " ", "\[Pi]"}]]}], "]"}], " ", 
        RowBox[{"Erfc", "[", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{
              FractionBox["1", "4"], " ", 
              RowBox[{"(", 
               RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "\[Pi]"}], "]"}], " ",
             "xx"}], 
           SqrtBox[
            RowBox[{"2", " ", "\[Pi]"}]]]}], "]"}]}], ",", "wp"}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"Gnum", "[", 
    RowBox[{
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"wp_", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xx", "=", 
       RowBox[{"N", "[", 
        RowBox[{"x", ",", "wp"}], "]"}]}], "}"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], "+", 
        FractionBox["\[ImaginaryI]", 
         RowBox[{"6", " ", "\[Pi]"}]], "-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["xx", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"\[ImaginaryI]", " ", "xx", " ", 
             RowBox[{"Fnum", "[", 
              RowBox[{"x", ",", "wp"}], "]"}]}]}], ")"}]}], 
         RowBox[{"6", " ", 
          SuperscriptBox["\[Pi]", "2"]}]]}], ",", "wp"}], "]"}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"Rnumeric", "[", 
    RowBox[{
     RowBox[{"q_", "?", "NumericQ"}], ",", 
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"wp_", ":", "40"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Znumeric", "[", 
     RowBox[{"q", ",", "x", ",", "wp"}], "]"}], "-", 
    RowBox[{"Fnum", "[", 
     RowBox[{"x", ",", "wp"}], "]"}], "-", 
    FractionBox[
     RowBox[{"Gnum", "[", 
      RowBox[{"x", ",", "wp"}], "]"}], 
     SqrtBox[
      RowBox[{"N", "[", 
       RowBox[{"q", ",", "wp"}], "]"}]]]}]}], ";", 
  RowBox[{
   RowBox[{"scaledR", "[", 
    RowBox[{
     RowBox[{"q_", "?", "NumericQ"}], ",", 
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"wp_", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"q", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{"Rnumeric", "[", 
      RowBox[{"q", ",", "x", ",", "wp"}], "]"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"testRow", "[", 
    RowBox[{
     RowBox[{"q_", "?", "NumericQ"}], ",", 
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"wp_", ":", "40"}]}], "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<q\>\"", "\[Rule]", "q"}], ",", 
     RowBox[{"\"\<x\>\"", "\[Rule]", "x"}], ",", 
     RowBox[{"\"\<precision\>\"", "\[Rule]", "wp"}], ",", 
     RowBox[{"\"\<qAbsR\>\"", "\[Rule]", 
      RowBox[{"scaledR", "[", 
       RowBox[{"q", ",", "x", ",", "wp"}], "]"}]}], ",", 
     RowBox[{"\"\<boundPassesNumerically\>\"", "\[Rule]", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"scaledR", "[", 
         RowBox[{"q", ",", "x", ",", "wp"}], "]"}], "<", 
        FractionBox["43", "10"]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Menlo",
 FontSize->11,
 FontColor->GrayLevel[0],
 Background->GrayLevel[1],
 CellTags->
  "Definitions",ExpressionUUID->"c77fa1af-2829-4bee-8a63-3b8b5a1a143f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "=", 
   FractionBox["9", "8"]}], ";", 
  RowBox[{"kappa", "=", 
   FractionBox["67", "20"]}], ";", 
  RowBox[{"coeffs", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     FractionBox["3", "4"], ",", 
     FractionBox["7", "6"], ",", 
     FractionBox["241", "84"], ",", 
     FractionBox["22", "21"], ",", 
     FractionBox["484", "441"]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"gauss", "[", 
    RowBox[{"k_Integer", "?", "EvenQ"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", "=", 
       FractionBox["k", "2"]}], "}"}], ",", 
     FractionBox[
      RowBox[{"67", " ", 
       SuperscriptBox["a", 
        RowBox[{"-", "m"}]], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "m"}], ")"}], "!"}]}], 
      RowBox[{"80", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["4", "m"], " ", 
         RowBox[{"m", "!"}]}], ")"}]}]]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"gauss", "[", 
    RowBox[{"k_Integer", "?", "OddQ"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", "=", 
       FractionBox[
        RowBox[{"k", "-", "1"}], "2"]}], "}"}], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      SuperscriptBox["a", 
       RowBox[{
        RowBox[{"-", "m"}], "-", "1"}]], " ", 
      RowBox[{"m", "!"}]}]}], "]"}]}], ";", 
  RowBox[{"jUpper", "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "2"}], "6"], 
    RowBox[{
     RowBox[{"coeffs", "\[LeftDoubleBracket]", 
      RowBox[{"k", "+", "1"}], "\[RightDoubleBracket]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"7", " ", 
         RowBox[{"gauss", "[", "k", "]"}]}], "4"], "+", 
       RowBox[{
        RowBox[{"k", "!"}], " ", 
        SuperscriptBox["kappa", 
         RowBox[{
          RowBox[{"-", "k"}], "-", "1"}]]}]}], ")"}]}]}]}], ";", 
  RowBox[{"mainB", "=", 
   RowBox[{
    FractionBox["5", "12"], "+", 
    FractionBox["5", "240"], "+", 
    FractionBox["22", 
     RowBox[{"7", " ", "72000"}]], "+", 
    FractionBox["1", "100000"]}]}], ";", 
  RowBox[{"mainC", "=", 
   RowBox[{
    FractionBox["jUpper", "2"], "+", "mainB"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<J upper\>\"", "\[Rule]", "jUpper"}], ",", 
    RowBox[{"\"\<B upper\>\"", "\[Rule]", "mainB"}], ",", 
    RowBox[{"\"\<Combined upper\>\"", "\[Rule]", "mainC"}], ",", 
    RowBox[{"\"\<Below 4.3\>\"", "\[Rule]", 
     RowBox[{"mainC", "<", 
      FractionBox["43", "10"]}]}]}], "]"}]}]], "Input",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Menlo",
 FontSize->11,
 FontColor->GrayLevel[0],
 Background->GrayLevel[1],
 CellTags->
  "Main bound",ExpressionUUID->"21a3c70b-ea4f-4cb2-8283-fd643d528806"],

Cell[BoxData[
 RowBox[{
  RowBox[{"qs", "=", 
   RowBox[{"{", 
    RowBox[{"100", ",", 
     FractionBox["100001", "1000"], ",", 
     FractionBox["201", "2"], ",", "101", ",", "150", ",", "400", ",", 
     "1600"}], "}"}]}], ";", 
  RowBox[{"xs", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1", ",", 
     FractionBox["1", "20"]}], "]"}]}], ";", 
  RowBox[{"rows", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "x", ",", 
         RowBox[{"scaledR", "[", 
          RowBox[{"q", ",", "x", ",", "55"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q", ",", "qs"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xs"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", 
  RowBox[{"extrema", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"rows", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#1", "]"}], "\[Equal]", "q"}], "&"}]}], 
         "]"}], ",", "Last"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"q", ",", "qs"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"precisionCheck", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"scaledR", "[", 
         RowBox[{
          RowBox[{"r", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}],
           ",", 
          RowBox[{"r", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}],
           ",", "75"}], "]"}], "-", 
        RowBox[{"Last", "[", "r", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "extrema"}], "}"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Points\>\"", "\[Rule]", 
     RowBox[{"Length", "[", "rows", "]"}]}], ",", 
    RowBox[{"\"\<All below 4.3\>\"", "\[Rule]", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"rows", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Last", "[", "#1", "]"}], "<", 
         FractionBox["43", "10"]}], "&"}]}], "]"}]}], ",", 
    RowBox[{"\"\<Maximum\>\"", "\[Rule]", 
     RowBox[{"First", "[", 
      RowBox[{"MaximalBy", "[", 
       RowBox[{"rows", ",", "Last"}], "]"}], "]"}]}], ",", 
    RowBox[{"\"\<Maximum precision drift\>\"", "\[Rule]", 
     "precisionCheck"}]}], "]"}]}]], "Input",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Menlo",
 FontSize->11,
 FontColor->GrayLevel[0],
 Background->GrayLevel[1],
 CellTags->
  "Grid and precision",ExpressionUUID->"ade66f08-e16f-463e-b39f-cb31454c1f3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zAP", "[", 
    RowBox[{"q_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "=", 
        RowBox[{
         RowBox[{"\[Pi]", " ", "q"}], "+", 
         RowBox[{"x", " ", 
          SqrtBox["q"]}]}]}], ",", "s", ",", "f", ",", 
       RowBox[{"p", "=", "60"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"s", "=", 
       RowBox[{
        FractionBox["1", "2"], "+", 
        RowBox[{"\[ImaginaryI]", " ", "t"}]}]}], ";", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"y_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"y", "\[Equal]", "0"}], ",", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[ImaginaryI]", " ", "s"}], 
           RowBox[{"\[Pi]", " ", "q"}]]}], ",", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              FractionBox[
               RowBox[{"\[ImaginaryI]", " ", "y"}], "q"]}], ")"}], 
            RowBox[{"-", "s"}]], "-", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               RowBox[{"\[ImaginaryI]", " ", "y"}], "q"]}], ")"}], 
            RowBox[{"-", "s"}]]}], 
          RowBox[{"2", " ", 
           RowBox[{"Sinh", "[", 
            RowBox[{"\[Pi]", " ", "y"}], "]"}]}]]}], "]"}]}], ";", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", " ", 
         SqrtBox["q"]}]], "+", 
       RowBox[{
        FractionBox["1", 
         SqrtBox["q"]], 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"f", "[", "y", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "0", ",", "1", ",", 
             SqrtBox["q"], ",", 
             RowBox[{"4", " ", 
              SqrtBox["q"]}], ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "\[Rule]", "p"}], ",", 
           RowBox[{"AccuracyGoal", "\[Rule]", "35"}], ",", 
           RowBox[{"PrecisionGoal", "\[Rule]", "35"}], ",", 
           RowBox[{"MaxRecursion", "\[Rule]", "30"}]}], "]"}]}]}]}]}]}], 
    "]"}]}], ";", 
  RowBox[{"apCheck", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"zAP", "[", 
            RowBox[{"100", ",", "x"}], "]"}], "-", 
           RowBox[{"Znumeric", "[", 
            RowBox[{"100", ",", "x", ",", "70"}], "]"}]}], "]"}], ",", "8"}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], "}"}]}], "]"}]}], 
  ";", "apCheck"}]], "Input",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Menlo",
 FontSize->11,
 FontColor->GrayLevel[0],
 Background->GrayLevel[1],
 CellTags->
  "Abel-Plana",ExpressionUUID->"e885ea74-f90f-466a-9e7f-fe59c53f2c16"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
