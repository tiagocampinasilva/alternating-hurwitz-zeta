Cell[CellGroupData[{

Cell["Appendix A. Possible refinement (pending validation)", "Section",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->GrayLevel[0],
 Background->GrayLevel[
  1],ExpressionUUID->"b88e33f0-b4bd-4512-a4bf-a30892e47b61"],

Cell["\<\
This appendix records the proposed 4.117/q refinement using a multiplier of 3 \
for the short-interval residual kernel. The exact arithmetic below checks the \
constant conditional on the analytic estimates. Independent validation of the \
uniform analytic argument is pending.\
\>", "Text",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->12,
 FontColor->GrayLevel[0],
 Background->GrayLevel[
  1],ExpressionUUID->"f8358420-d871-40cd-b20e-d4a3af0eb480"]
}, Closed]],

Cell[CellGroupData[{

Cell["A.1. Refined residual-kernel calculation", "Section",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->16,
 FontWeight->"Bold",
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"240b72de-aa0b-4ab8-8655-88b42c675162"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", "\[LongEqual]", 
      RowBox[{
       SuperscriptBox["tan", 
        RowBox[{"-", "1"}]], "(", 
       FractionBox["y", "q"], ")"}]}], ",", 
     RowBox[{
      RowBox[{"D", "[", "y", "]"}], "\[LongEqual]", 
      RowBox[{
       RowBox[{"2", " ", "\[Pi]", " ", "y"}], "-", 
       RowBox[{"2", " ", "t", " ", "\[Theta]"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]}]}], ",", 
     RowBox[{
      RowBox[{"K", "[", "y", "]"}], "\[LongEqual]", 
      FractionBox[
       RowBox[{
        RowBox[{"w", "(", "y", ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"exp", "(", 
           RowBox[{"D", "[", "y", "]"}], ")"}]}], ")"}]}], 
       RowBox[{
        RowBox[{"exp", "(", 
         RowBox[{"2", " ", "\[Pi]", " ", "y"}], ")"}], "-", "1"}]]}]}], "}"}],
   
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->17,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"1b1959d9-667f-4b4f-8f43-60dcfc5d058f"],

Cell[TextData[{
 "For y up to log q, replace the argument y in each increasing term of the \
next bound by log q. The resulting terms decrease for ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    TagBox[
     RowBox[{"q", "\[GreaterEqual]", "100"}],
     HoldForm],
    TraditionalForm],
   FontSize->14]], "InlineFormula",ExpressionUUID->
  "774a34b9-5392-4fc6-85fa-3e3df5c5fb94"],
 ", since the sign of the derivative of q raised to \[Minus]a times (log q) \
raised to k is the sign of ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    TagBox[
     RowBox[{"k", "-", 
      RowBox[{"a", " ", 
       RowBox[{"log", "(", "q", ")"}]}]}],
     HoldForm],
    TraditionalForm],
   FontSize->14]], "InlineFormula",ExpressionUUID->
  "ac796198-055e-4b92-8fb3-b1b1cc6baa1c"],
 ". Use the pairs (1/2, 1), (1, 1) and (2, 3)."
}], "Text",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->12,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"b0492aeb-2d90-481f-960f-d89306703605"],

Cell[BoxData[FormBox[TagBox[RowBox[
                {TemplateBox[{RowBox[{"D", "[", "y", "]"}]}, "Abs"], 
                 "\[LessEqual]", RowBox[{FractionBox[RowBox[{"2", " ", "y"}], 
                    SqrtBox["q"]], "+", FractionBox["y", "q"], "+", 
                   FractionBox[RowBox[{"2", " ", "\[Pi]", " ", SuperscriptBox[
                       "y", "3"]}], RowBox[{"3", " ", SuperscriptBox["q", 
                       "2"]}]]}]}], HoldForm], TraditionalForm]], 
            "DisplayFormula", CellFrame -> False, CellMargins -> 
             {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
            FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
             "a3ce5daf-b7ed-4689-8121-08ac26d99726"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[
                  {RowBox[{TemplateBox[{RowBox[{"D", "[", "y", "]"}]}, 
                      "Abs"], "<", FractionBox["51902943991", "52500000000"], 
                     "<", FractionBox["989", "1000"]}], ",", RowBox[
                    {TemplateBox[{RowBox[{"w", "(", "y", ")"}]}, "Abs"], 
                     "\[LessEqual]", RowBox[{"exp", "(", FractionBox["y", 
                        SqrtBox["q"]], ")"}], "<", FractionBox["5", "3"]}]}], 
                 "}"}], HoldForm], TraditionalForm]], "DisplayFormula", 
            CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
            FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
             RGBColor[0, 0, 0], ExpressionUUID -> 
             "5b8d8f6c-de72-43c1-965d-7211af790adf"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    TagBox[
     RowBox[{
      TemplateBox[{"D"},
       "Abs"], "\[LessEqual]", "1"}],
     HoldForm],
    TraditionalForm],
   FontSize->14]], "InlineFormula",ExpressionUUID->
  "cff80b20-97e2-441d-a374-273bc36ab932"],
 ", factoring |D| out of the exponential series bounds its remaining sum by e \
\[Minus] 1. Together with ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    TagBox[
     RowBox[{"\[ExponentialE]", "<", 
      FractionBox["11", "4"]}],
     HoldForm],
    TraditionalForm],
   FontSize->14]], "InlineFormula",ExpressionUUID->
  "7951fa0a-c036-46b6-bae0-9dd09f630f00"],
 ", this reduces the multiplier in equation (18) from 5 to 3."
}], "Text",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->12,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"2413da70-4cb8-41fa-af28-9639c90e08e0"],

Cell[BoxData[FormBox[TagBox[RowBox[
                {TemplateBox[{RowBox[{"1", "-", RowBox[{"exp", "(", RowBox[
                        {"D", "[", "y", "]"}], ")"}]}]}, "Abs"], 
                 "\[LessEqual]", RowBox[{RowBox[{"(", RowBox[
                      {"\[ExponentialE]", "-", "1"}], ")"}], " ", TemplateBox[
                    {RowBox[{"D", "[", "y", "]"}]}, "Abs"]}]}], HoldForm], 
              TraditionalForm]], "DisplayFormula", CellFrame -> False, 
            CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
            FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
            ExpressionUUID -> "b47c76b8-f732-401f-9041-e2a184bc6b0a"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    TemplateBox[{
      RowBox[{
        RowBox[{"w", "(", "y", ")"}], " ", 
        RowBox[{"(", 
          RowBox[{"1", "-", 
            RowBox[{"exp", "(", 
              RowBox[{"D", "[", "y", "]"}], ")"}]}], ")"}]}]},
     "Abs"], "\[LessEqual]", 
    FractionBox[
     RowBox[{"35", " ", 
      TemplateBox[{
        RowBox[{"D", "[", "y", "]"}]},
       "Abs"]}], "12"], "\[LessEqual]", 
    RowBox[{"3", " ", 
     TemplateBox[{
       RowBox[{"D", "[", "y", "]"}]},
      "Abs"]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->17,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"e173ca62-f9c4-4b3e-ac62-ab670e36d201"],

Cell["On the tail, use the original bound (19). On the short \
interval, extend the nonnegative moment integrands to infinity. Expanding the \
geometric series in the denominator gives these two moments.", "Text", 
            CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
            FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
             RGBColor[0, 0, 0], ExpressionUUID -> 
             "3c8184e5-6b6d-48c3-bdee-1d2ebbc5c1fa"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TemplateBox[{
        FractionBox["y", 
         RowBox[{
           RowBox[{"exp", "(", 
             RowBox[{"2", " ", "\[Pi]", " ", "y"}], ")"}], "-", "1"}]], "y", 
        "0", "\[Infinity]"},
       "InactiveIntegrate",
       DisplayFunction->(RowBox[{
          SubsuperscriptBox[
           StyleBox["\[Integral]", "InactiveTraditional"], #3, #4], 
          RowBox[{#, 
            RowBox[{
              StyleBox["\[DifferentialD]", "InactiveTraditional"], #2}]}]}]& ),
       InterpretationFunction->(RowBox[{
          RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
          RowBox[{#, ",", 
            RowBox[{"{", 
              RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )], "\[LongEqual]", 
      FractionBox["1", "24"]}], ",", 
     RowBox[{
      TemplateBox[{
        FractionBox[
         SuperscriptBox["y", "3"], 
         RowBox[{
           RowBox[{"exp", "(", 
             RowBox[{"2", " ", "\[Pi]", " ", "y"}], ")"}], "-", "1"}]], "y", 
        "0", "\[Infinity]"},
       "InactiveIntegrate",
       DisplayFunction->(RowBox[{
          SubsuperscriptBox[
           StyleBox["\[Integral]", "InactiveTraditional"], #3, #4], 
          RowBox[{#, 
            RowBox[{
              StyleBox["\[DifferentialD]", "InactiveTraditional"], #2}]}]}]& ),
       InterpretationFunction->(RowBox[{
          RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
          RowBox[{#, ",", 
            RowBox[{"{", 
              RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )], "\[LongEqual]", 
      FractionBox["1", "240"]}]}], "}"}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->17,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"aa12c3f5-5ef3-4d44-9733-8af13616e9f0"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SqrtBox["q"], " ", 
     TemplateBox[{
       TemplateBox[{
         RowBox[{"K", "[", "y", "]"}]}, "Abs"], "y", "0", "\[Infinity]"},
      "InactiveIntegrate",
      DisplayFunction->(RowBox[{
         SubsuperscriptBox[
          StyleBox["\[Integral]", "InactiveTraditional"], #3, #4], 
         RowBox[{#, 
           RowBox[{
             StyleBox["\[DifferentialD]", "InactiveTraditional"], #2}]}]}]& ),
      
      InterpretationFunction->(RowBox[{
         RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
         RowBox[{#, ",", 
           RowBox[{"{", 
             RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}], "\[LessEqual]", 
    RowBox[{
     FractionBox["3", "12"], "+", 
     FractionBox["3", 
      RowBox[{"24", " ", 
       SqrtBox["q"]}]], "+", 
     FractionBox["\[Pi]", 
      RowBox[{"120", " ", 
       SuperscriptBox["q", 
        RowBox[{"3", "/", "2"}]]}]], "+", 
     FractionBox[
      RowBox[{"3", " ", 
       SuperscriptBox["q", 
        RowBox[{
         FractionBox["1", "2"], "-", "\[Pi]"}]]}], "\[Pi]"]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->17,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"ed21258a-0761-478c-98e0-537881e6a307"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    TagBox[
     RowBox[{"q", "\[GreaterEqual]", "100"}],
     HoldForm],
    TraditionalForm],
   FontSize->14]], "InlineFormula",ExpressionUUID->
  "a5ee2671-6338-4587-bc94-e9966fbc82a9"],
 " the tail is smaller than 10\:207b\:2075. The remaining terms are bounded \
with ",
 Cell[BoxData[
  StyleBox[
   FormBox[
    TagBox[
     RowBox[{"q", "\[GreaterEqual]", "100"}],
     HoldForm],
    TraditionalForm],
   FontSize->14]], "InlineFormula",ExpressionUUID->
  "00a6f6c6-7ff1-459d-b701-5ec9d244b0e6"],
 " and \[Pi] < 22/7."
}], "Text",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->12,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"266462d4-4daa-40d9-af0a-aab14959b982"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["B", "0"], "\[LongEqual]", 
    RowBox[{
     FractionBox["3", "12"], "+", 
     FractionBox["3", "240"], "+", 
     FractionBox["22", 
      RowBox[{"7", " ", "120000"}]], "+", 
     FractionBox["1", "100000"]}], "\[LongEqual]", 
    FractionBox["275663", "1050000"]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->17,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"5fe04ad9-4b05-4e54-8f6d-f3e1597132a0"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"q", " ", 
     TemplateBox[{
       RowBox[{
         SubscriptBox["R", "q"], "(", "x", ")"}]},
      "Abs"]}], "\[LessEqual]", 
    FractionBox["356452924783991052355217", "86597871701497153200000"], "<", 
    FractionBox["4117", "1000"]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellFrame->False,
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Georgia",
 FontSize->17,
 FontColor->RGBColor[
  0, 0, 0],ExpressionUUID->"08d90f7f-dd4f-4a1c-981e-e6eee865ab84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bUpper", "=", 
   RowBox[{
    FractionBox["3", "12"], "+", 
    FractionBox["3", "240"], "+", 
    FractionBox["22", 
     RowBox[{"7", " ", "120000"}]], "+", 
    FractionBox["1", "100000"]}]}], ";", 
  RowBox[{"cUpper", "=", 
   RowBox[{
    FractionBox["jUpper", "2"], "+", "bUpper"}]}], ";", 
  RowBox[{"certificate", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"jUpper", ",", "20"}], "]"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{"bUpper", ",", "20"}], "]"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{"cUpper", ",", "20"}], "]"}], ",", 
     RowBox[{"cUpper", "<", 
      FractionBox["4117", "1000"]}], ",", 
     RowBox[{
      FractionBox["4117", "1000"], "-", "cUpper"}]}], "}"}]}], ";", 
  RowBox[{"z", "=", 
   FractionBox["461", "100"]}], ";", 
  RowBox[{"dUpper", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"21", " ", "z"}], "100"], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "22"}], ")"}], " ", 
      SuperscriptBox["z", "3"]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"7", " ", "3"}], ")"}], " ", "10000"}]]}]}], ";", 
  RowBox[{
   RowBox[{"expUpper", "[", "z_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "6"], 
     FractionBox[
      SuperscriptBox["z", "k"], 
      RowBox[{"k", "!"}]]}], "+", 
    FractionBox[
     SuperscriptBox["z", "7"], 
     RowBox[{
      RowBox[{"7", "!"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox["z", "8"]}], ")"}]}]]}]}], ";", 
  RowBox[{"localChecks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"expUpper", "[", 
       FractionBox["1", "2"], "]"}], "<", 
      FractionBox["5", "3"]}], ",", 
     RowBox[{
      RowBox[{"expUpper", "[", "1", "]"}], "<", 
      FractionBox["11", "4"]}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["5", "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["11", "4"], "-", "1"}], ")"}]}], "<", "3"}], ",", 
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "0"}], "16"], 
       FractionBox[
        SuperscriptBox["z", "k"], 
        RowBox[{"k", "!"}]]}], ">", "100"}], ",", 
     RowBox[{"dUpper", "<", 
      FractionBox["989", "1000"]}], ",", 
     RowBox[{
      FractionBox["22", "7"], ">", "\[Pi]"}], ",", 
     RowBox[{"\[Pi]", ">", 
      FractionBox["157", "50"]}]}], "}"}]}], ";", 
  RowBox[{"s2lo", "=", 
   FractionBox["140", "99"]}], ";", 
  RowBox[{"s2hi", "=", 
   FractionBox["99", "70"]}], ";", 
  RowBox[{"r0", "=", 
   FractionBox["3", "10"]}], ";", 
  RowBox[{"vHi", "=", 
   FractionBox["r0", 
    RowBox[{"s2lo", "+", "r0"}]]}], ";", 
  RowBox[{"deltaLo", "=", 
   RowBox[{
    FractionBox["r0", "s2hi"], "-", 
    RowBox[{"(", 
     RowBox[{"vHi", "-", 
      FractionBox[
       SuperscriptBox["vHi", "3"], "3"], "+", 
      FractionBox[
       SuperscriptBox["vHi", "5"], "5"]}], ")"}]}]}], ";", 
  RowBox[{"ex", "=", 
   FractionBox["11", "20"]}], ";", 
  RowBox[{"twoScaleChecks", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["s2lo", "2"], "<", "2", "<", 
      SuperscriptBox["s2hi", "2"]}], ",", 
     RowBox[{"0", "<", "vHi", "<", "1"}], ",", 
     RowBox[{"deltaLo", ">", "0"}], ",", 
     RowBox[{
      FractionBox[
       RowBox[{"157", " ", "deltaLo"}], 
       RowBox[{"50", " ", 
        SuperscriptBox["r0", "2"]}]], ">", 
      RowBox[{
       FractionBox["9", "8"], "+", 
       FractionBox["5", "22"]}]}], ",", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"10", " ", "157", " ", "deltaLo"}], 
        RowBox[{"50", " ", "r0"}]], "-", 
       FractionBox["1", "s2lo"]}], ">", 
      FractionBox["67", "20"]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "0"}], "6"], 
        FractionBox[
         SuperscriptBox["ex", "k"], 
         RowBox[{"k", "!"}]]}], "+", 
       FractionBox[
        SuperscriptBox["ex", "7"], 
        RowBox[{
         RowBox[{"7", "!"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox["ex", "8"]}], ")"}]}]]}], "<", 
      FractionBox["7", "4"]}], ",", 
     RowBox[{
      FractionBox[
       RowBox[{"8", " ", "22"}], 
       RowBox[{"9", " ", "7"}]], "<", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["67", "40"], ")"}], "2"]}]}], "}"}]}], ";", 
  RowBox[{"polyCheck", "=", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"22", " ", 
           SuperscriptBox["u", "3"]}], "21"], "+", 
         FractionBox[
          SuperscriptBox["u", "2"], "2"], "+", 
         FractionBox["u", "2"]}], ")"}], "2"], "+", 
      FractionBox[
       RowBox[{"11", " ", 
        SuperscriptBox["u", "4"]}], "7"], "+", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["u", "3"]}], "3"], "+", 
      FractionBox[
       SuperscriptBox["u", "2"], "2"], "-", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "2"}], "6"], 
       RowBox[{
        RowBox[{"coeffs", "\[LeftDoubleBracket]", 
         RowBox[{"k", "+", "1"}], "\[RightDoubleBracket]"}], " ", 
        SuperscriptBox["u", "k"]}]}]}], "]"}], "===", "0"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Local inequalities\>\"", "\[Rule]", "localChecks"}], ",", 
    RowBox[{"\"\<Two-scale inequalities\>\"", "\[Rule]", "twoScaleChecks"}], ",", 
    RowBox[{"\"\<Polynomial identity\>\"", "\[Rule]", "polyCheck"}], ",", 
    RowBox[{"\"\<Exact-arithmetic result\>\"", "\[Rule]", "certificate"}]}], 
   "]"}]}]], "Input",
 CellMargins->{{42, 36}, {5, 9}},
 FontFamily->"Menlo",
 FontSize->11,
 FontColor->GrayLevel[0],
 Background->GrayLevel[1],
 CellTags->
  "Refinement",ExpressionUUID->"70437c12-de16-4cee-be3b-58cd1eb7d1b0"]
}, Open  ]],

