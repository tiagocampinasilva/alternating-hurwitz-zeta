}, Open  ]],

Cell[CellGroupData[{

Cell["4. Rotation of the principal integral", 
         "Section", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 16, FontWeight -> "Bold", 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "a2aefba3-c2d6-4d4c-b3ce-ce03b435247a"],

Cell[TextData[{"Use the principal branch and the contour rotation in \
manuscript Section 4. Substituting ", Cell[BoxData[StyleBox[FormBox[TagBox[
                RowBox[{"z", "\[LongEqual]", RowBox[{"h", " ", "y"}]}], 
                HoldForm], TraditionalForm], FontSize -> 14]], 
            "InlineFormula", ExpressionUUID -> 
             "79967212-20f5-4a0e-aed0-4c0d30acb0ee"], " gives the following \
exponent on the rotated ray \[CapitalGamma]."}], "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "98b82223-1233-43d9-963a-fd30bbcf1734"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SubscriptBox[
                 "\[CapitalPsi]", "h"], "(", "z", ")"}], "\[LongEqual]", 
              RowBox[{RowBox[{"-", FractionBox[RowBox[{"\[Pi]", " ", "z"}], 
                   "h"]}], "-", RowBox[{RowBox[{"(", RowBox[{FractionBox["1", 
                       "2"], "+", FractionBox[RowBox[{"\[ImaginaryI]", " ", 
                         "\[Pi]"}], SuperscriptBox["h", "2"]], "+", 
                      FractionBox[RowBox[{"\[ImaginaryI]", " ", "x"}], 
                       "h"]}], ")"}], " ", RowBox[{"log", "(", RowBox[
                     {"1", "+", RowBox[{"\[ImaginaryI]", " ", "h", " ", 
                        "z"}]}], ")"}]}]}]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "7c12b404-c059-49f0-8ef7-09e37b564e47"],

Cell["The linear term of \
the logarithm cancels the pole in h. The next two terms identify the constant \
and linear coefficients. The exact logarithmic remainders in equations \
(22)\[Dash](23) justify the extension to h = 0.", "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "d94bd401-941d-4236-8161-442fb8a4db5d"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {RowBox[{SubscriptBox["\[CapitalPhi]", "x"], "(", "z", 
                    ")"}], "\[LongEqual]", RowBox[{RowBox[{FractionBox["1", 
                       "2"], " ", RowBox[{"(", RowBox[{"-", 
                          "\[ImaginaryI]"}], ")"}], " ", "\[Pi]", " ", 
                      SuperscriptBox["z", "2"]}], "+", RowBox[{"x", " ", 
                      "z"}]}]}], ",", RowBox[{RowBox[{SubscriptBox["P", "x"], 
                    "(", "z", ")"}], "\[LongEqual]", RowBox[
                   {RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", 
                        RowBox[{"-", "\[ImaginaryI]"}], ")"}], " ", "z"}], 
                    "-", RowBox[{FractionBox["1", "2"], " ", "\[ImaginaryI]", 
                      " ", "x", " ", SuperscriptBox["z", "2"]}], "-", 
                    FractionBox[RowBox[{"\[Pi]", " ", SuperscriptBox["z", 
                        "3"]}], "3"]}]}]}], "}"}], HoldForm], 
           TraditionalForm]], "DisplayFormula", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 17, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "ea0c92a2-62bf-4622-ae57-981836c8e934"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Taylor remainder under the integral", 
         "Section", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 16, FontWeight -> "Bold", 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "4490f430-0a56-4698-ab1a-1c35281b0fc5"],

Cell["On the rotated ray, \
the chain rule bounds the second derivative of the exponential by the \
exponential modulus times the square of the first-derivative majorant plus \
the second-derivative majorant. Equations (25)\[Dash](32) bound this product \
by the integrable function M P\:1d66.", "Text", CellFrame -> False, 
         CellMargins -> {{42, 36}, {5, 9}}, FontFamily -> "Georgia", 
         FontSize -> 12, FontColor -> RGBColor[0, 0, 0], 
         ExpressionUUID -> "7a21eaef-817d-4dd1-a531-bff1c3d27274"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {RowBox[{"M", "(", "u", ")"}], "\[LongEqual]", RowBox[
                   {RowBox[{FractionBox["7", "4"], " ", RowBox[{"exp", "(", 
                        RowBox[{"-", FractionBox[RowBox[{"9", " ", 
                          SuperscriptBox["u", "2"]}], "8"]}], ")"}]}], "+", 
                    RowBox[{"exp", "(", RowBox[{"-", FractionBox[RowBox[
                          {"67", " ", "u"}], "20"]}], ")"}]}]}], ",", 
                RowBox[{RowBox[{SubscriptBox["P", "b"], "(", "u", ")"}], 
                  "\[LongEqual]", RowBox[{FractionBox[RowBox[{"484", " ", 
                       SuperscriptBox["u", "6"]}], "441"], "+", FractionBox[
                     RowBox[{"22", " ", SuperscriptBox["u", "5"]}], "21"], 
                    "+", FractionBox[RowBox[{"241", " ", SuperscriptBox["u", 
                        "4"]}], "84"], "+", FractionBox[RowBox[{"7", " ", 
                       SuperscriptBox["u", "3"]}], "6"], "+", FractionBox[
                     RowBox[{"3", " ", SuperscriptBox["u", "2"]}], 
                     "4"]}]}]}], "}"}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "6b747d8d-e0ff-4409-9e16-a78d90564d21"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {SubscriptBox["J", "\"*\""], "\[LongEqual]", TemplateBox[
                   {RowBox[{RowBox[{"M", "(", "u", ")"}], " ", RowBox[
                       {SubscriptBox["P", "b"], "(", "u", ")"}]}], "u", "0", 
                    "\[Infinity]"}, "InactiveIntegrate", DisplayFunction -> 
                    (RowBox[{SubsuperscriptBox[StyleBox["\[Integral]", 
                         "InactiveTraditional"], #3, #4], RowBox[{#1, 
                         RowBox[{StyleBox["\[DifferentialD]", 
                          "InactiveTraditional"], #2}]}]}] & ), 
                   InterpretationFunction -> (RowBox[{RowBox[{"Inactive", 
                         "[", "Integrate", "]"}], "[", RowBox[{#1, ",", 
                         RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                          "}"}]}], "]"}] & )]}], ",", RowBox[
                 {TemplateBox[{RowBox[{RowBox[{"H", "(", RowBox[{"h", ",", 
                          "x"}], ")"}], "-", RowBox[{SubscriptBox["J", "0"], 
                        "(", "x", ")"}], "-", RowBox[{"h", " ", RowBox[
                         {SubscriptBox["J", "1"], "(", "x", ")"}]}]}]}, 
                   "Abs"], "\[LessEqual]", FractionBox[RowBox[{SuperscriptBox[
                      "h", "2"], " ", SubscriptBox["J", "\"*\""]}], "2"]}]}], 
              "}"}], HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "5962899c-ac33-4cbd-99d7-5744fd22d16e"],

Cell["Here J\:2080 is the \
integral of the limiting exponential on \[CapitalGamma], and J\:2081 is its \
integral weighted by the linear coefficient P\:2093. The factor h\262/2 comes \
from integrating the Taylor weight h \[Minus] v from 0 to h.", "Text", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "f302dfe0-ee47-4e3c-b18e-48f061c43a31"],

Cell[BoxData[FormBox[TagBox[RowBox[{TemplateBox[{RowBox[
                 {SuperscriptBox["u", "k"], " ", RowBox[{"exp", "(", 
                    RowBox[{"-", FractionBox[RowBox[{"9", " ", SuperscriptBox[
                          "u", "2"]}], "8"]}], ")"}]}], "u", "0", 
                "\[Infinity]"}, "InactiveIntegrate", DisplayFunction -> 
                (RowBox[{SubsuperscriptBox[StyleBox["\[Integral]", 
                     "InactiveTraditional"], #3, #4], RowBox[{#1, RowBox[
                      {StyleBox["\[DifferentialD]", "InactiveTraditional"], 
                       #2}]}]}] & ), InterpretationFunction -> 
                (RowBox[{RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
                   RowBox[{#1, ",", RowBox[{"{", RowBox[{#2, ",", #3, ",", 
                         #4}], "}"}]}], "]"}] & )], "\[LongEqual]", 
              RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
                 RowBox[{"(", FractionBox["8", "9"], ")"}], FractionBox[
                  RowBox[{"k", "+", "1"}], "2"]], " ", TemplateBox[
                 {FractionBox[RowBox[{"k", "+", "1"}], "2"]}, "Gamma"]}]}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "ccffa0be-dbaf-4601-9e52-fee6a3b38b43"],

Cell[BoxData[FormBox[TagBox[RowBox[{TemplateBox[{RowBox[
                 {SuperscriptBox["u", "k"], " ", RowBox[{"exp", "(", 
                    RowBox[{"-", FractionBox[RowBox[{"67", " ", "u"}], 
                       "20"]}], ")"}]}], "u", "0", "\[Infinity]"}, 
               "InactiveIntegrate", DisplayFunction -> 
                (RowBox[{SubsuperscriptBox[StyleBox["\[Integral]", 
                     "InactiveTraditional"], #3, #4], RowBox[{#1, RowBox[
                      {StyleBox["\[DifferentialD]", "InactiveTraditional"], 
                       #2}]}]}] & ), InterpretationFunction -> 
                (RowBox[{RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
                   RowBox[{#1, ",", RowBox[{"{", RowBox[{#2, ",", #3, ",", 
                         #4}], "}"}]}], "]"}] & )], "\[LongEqual]", 
              RowBox[{RowBox[{"k", "!"}], " ", SuperscriptBox[RowBox[
                  {"(", FractionBox["20", "67"], ")"}], RowBox[{"k", "+", 
                   "1"}]]}]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", CellFrame -> False, CellMargins -> 
          {{42, 36}, {5, 9}}, FontFamily -> "Georgia", FontSize -> 17, 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "e8f984c6-623d-4b0d-8368-769b32801b0b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. The approximation and the final constant", 
         "Section", CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 16, FontWeight -> "Bold", 
         FontColor -> RGBColor[0, 0, 0], ExpressionUUID -> 
          "5abf2640-5f4c-46e3-b9d7-27cc0e2f16f4"],

Cell[TextData[{"The Gaussian contour gives ", 
           Cell[BoxData[StyleBox[FormBox[TagBox[RowBox[{RowBox[
                   {"\[ImaginaryI]", " ", SubscriptBox["J", "0"]}], 
                  "\[LongEqual]", "F"}], HoldForm], TraditionalForm], 
              FontSize -> 14]], "InlineFormula", ExpressionUUID -> 
             "52818a44-b958-483e-9f9b-13baac153336"], ". Differentiate the \
Fresnel identity to express the first correction in terms of F."}], "Text", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 12, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "495368ac-09d5-43bd-87d4-9f112e0ea067"],

Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"F", "(", "x", ")"}], 
              "\[LongEqual]", RowBox[{FractionBox["1", "2"], " ", 
                RowBox[{"(", RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], " ", 
                RowBox[{"exp", "(", RowBox[{"-", FractionBox[RowBox[
                      {"\[ImaginaryI]", " ", SuperscriptBox["x", "2"]}], 
                     RowBox[{"2", " ", "\[Pi]"}]]}], ")"}], " ", 
                RowBox[{"erfc", "(", RowBox[{"-", FractionBox[RowBox[
                      {RowBox[{"exp", "(", RowBox[{FractionBox["1", "4"], 
                          " ", RowBox[{"(", RowBox[{"-", "\[ImaginaryI]"}], 
                          ")"}], " ", "\[Pi]"}], ")"}], " ", "x"}], 
                     SqrtBox[RowBox[{"2", " ", "\[Pi]"}]]]}], ")"}]}]}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         CellFrame -> False, CellMargins -> {{42, 36}, {5, 9}}, 
         FontFamily -> "Georgia", FontSize -> 17, FontColor -> 
          RGBColor[0, 0, 0], ExpressionUUID -> 
          "864dd4db-8c07-4a8f-b336-f176df84112a"],

Cell[BoxData[FormBox[TagBox[RowBox[{"{", RowBox[{RowBox[
                 {RowBox[{"\[Pi]", " ", RowBox[{SuperscriptBox["F", 
                       "\[Prime]", MultilineFunction -> None], "(", "x", 
                      ")"}]}], "\[LongEqual]", RowBox[{"1", "-", RowBox[
                     {"\[ImaginaryI]", " ", "x", " ", RowBox[{"F", "(", "x", 
                        ")"}]}]}]}], ",", RowBox[{RowBox[{"\[Pi]", " ", 
                    RowBox[{SuperscriptBox["F", "\[Prime]\[Prime]", 
                       MultilineFunction -> None], "(", "x", ")"}]}], 
                  "\[LongEqual]", RowBox[{RowBox[{RowBox[{"-", 
                        "\[ImaginaryI]"}], " ", RowBox[{"F", "(", "x", 
                        ")"}]}], "-", RowBox[{"\[ImaginaryI]", " ", "x", " ", 
                      RowBox[{SuperscriptBox["F", "\[Prime]", 
                         MultilineFunction -> None], "(", "x", ")"}]}]}]}], 
                ",", RowBox[{RowBox[{"\[Pi]", " ", RowBox[{SuperscriptBox[
                       "F", TagBox[RowBox[{"(", "3", ")"}], Derivative], 
                       MultilineFunction -> None], "(", "x", ")"}]}], 
                  "\[LongEqual]", RowBox[{RowBox[{RowBox[{"-", "2"}], " ", 
                      "\[ImaginaryI]", " ", RowBox[{SuperscriptBox["F", 
                         "\[Prime]", MultilineFunction -> None], "(", "x", 
                        ")"}]}], "-", RowBox[{"\[ImaginaryI]", " ", "x", " ", 
                      RowBox[{SuperscriptBox["F", "\[Prime]\[Prime]", 
                         MultilineFunction -> None], "(", "x", ")"}]}]}]}]}], 
              "}"}], HoldForm], TraditionalForm]], "DisplayFormula", 
